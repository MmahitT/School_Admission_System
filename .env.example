# Copy to .env, then fill in the REQUIRED values below:   cp .env.example .env
# .env is git-ignored. Never commit it, and never put real secrets in this file.
#
# Docker Compose refuses to start while a REQUIRED value is missing or empty.

# --- PostgreSQL (all three REQUIRED) ---
POSTGRES_DB=school_admission
POSTGRES_USER=school_admin
# REQUIRED. Deliberately empty here: choose your own. Use letters and digits only
# (it is embedded in a connection string). Generate one with:   openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Backend (optional; safe defaults shown) ---
# Seconds a seat stays reserved before the hold expires.
HOLD_DURATION_SECONDS=600
# How often the background sweeper marks expired holds, in seconds.
EXPIRATION_SWEEP_INTERVAL_SECONDS=5
# Comma-separated browser origins allowed by CORS (only needed for the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (optional) ---
# Base URL the browser app uses for API calls. Public by design: it is compiled into the JavaScript bundle.
# Only VITE_* values ever reach the frontend; database credentials never do.
VITE_API_BASE_URL=/api

# --- Host port for the whole app (nginx) ---
APP_PORT=8080
