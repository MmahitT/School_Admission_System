# Copy to .env and adjust. .env is git-ignored.

# --- PostgreSQL ---
POSTGRES_DB=school_admission
POSTGRES_USER=school_admin
POSTGRES_PASSWORD=change_me_please

# --- Backend ---
# Seconds a seat stays reserved before the hold expires.
HOLD_DURATION_SECONDS=600
# Interval of the background expiration sweeper, in seconds.
EXPIRATION_SWEEP_INTERVAL_SECONDS=5
# Comma-separated browser origins allowed by CORS (Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
# Base URL the SPA uses for API calls. "/api" is proxied by nginx.
VITE_API_BASE_URL=/api

# --- Host port for the whole app (nginx) ---
APP_PORT=8080
